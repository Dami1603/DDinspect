{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "DDinspect",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "ddinspect@ddinspect.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "DDinspect",
    "default_panel": "sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["sidePanel", "contextMenus", "storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/ddinspect-shared.js", "content/scan.js", "content/export.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-ddinspect": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_commandToggle__"
    }
  }
}
